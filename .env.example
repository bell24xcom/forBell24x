# Database (Neon PostgreSQL - replace with your connection string)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
NEXTAUTH_SECRET="another-secret-key-for-nextauth"
NEXTAUTH_URL="https://bell24h.com"

# SMS/OTP (MSG91)
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="BELL24"
MSG91_TEMPLATE_ID="your-template-id"

# Payment (Razorpay)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Cloudinary (product image uploads — src/lib/cloudinary-server.ts)
# Without these, /api/supplier/upload-image falls back to writing under
# public/uploads/, which does not persist on Vercel (read-only filesystem).
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# InsForge (optional — marketing automation, campaign rules)
# Server-side keys (used by /api/admin/marketing and /api/insforge/status):
INSFORGE_URL="https://your-project.region.insforge.app"
INSFORGE_API_KEY="your-service-role-key"
# Public keys (client-side fallback):
NEXT_PUBLIC_INSFORGE_BASE_URL="https://your-project.region.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="your-anon-key"

NODE_ENV="production"

# bell24h-v2 Live Sync (/admin/import → "Pull from bell24h-v2")
# BELL24H_V2_EXPORT_KEY must equal ADMIN_API_KEY in bell24h-v2's Vercel env.
# Auth header used: x-admin-key (verified from digitex-erp/bell24h-v2 adminGuard.ts)
# Endpoint called: POST {BELL24H_V2_URL}/api/export/crm  (returns up to 500 CRM leads)
BELL24H_V2_URL="https://bell24h-v2.vercel.app"
BELL24H_V2_EXPORT_KEY="your-admin-api-key-from-bell24h-v2"

# ─── WhatsApp Bulk Outreach (/api/admin/outreach/bulk-wa) ────────────────────
# All three vars required for configured:true and auto-send.
# Without them, the status GET returns configured:false and POST only generates
# wa.me click-to-chat links (no API call made). Daily cap: 50 messages/IST day.
# Use POST ?dryRun=true to preview sends without touching the DB or calling MSG91.
#
# How to get these:
#   1. Log in to MSG91 → WhatsApp → Enable WhatsApp Business API
#   2. MSG91_WA_PHONE  = your approved WABA number in E.164 without "+" e.g. "919004962871"
#   3. MSG91_WA_TEMPLATE = the approved Meta template name (not the ID) e.g. "supplier_claim_invite"
#   4. MSG91_WA_AUTH_KEY = your MSG91 auth key (can reuse MSG91_AUTH_KEY if same account)
MSG91_WA_AUTH_KEY=""        # required: MSG91 auth key (or reuse MSG91_AUTH_KEY)
MSG91_WA_PHONE=""           # required: WABA number without "+" e.g. "919004962871"
MSG91_WA_TEMPLATE=""        # required: approved Meta template name e.g. "supplier_claim_invite"

# Google Analytics 4
# Set NEXT_PUBLIC_GA_ID in Vercel Dashboard → Settings → Environment Variables
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console API (SEO Cockpit → Search Console live sync)
# Paste full service account JSON (single line) from Google Cloud Console.
# Add service account email as Owner in GSC → Settings → Users.
GSC_SERVICE_ACCOUNT_JSON=""
GSC_SITE_URL="sc-domain:vyaparsethu.com"

# SHAP/LIME explainability (Render.com — ai-explainability-service)
# Without this, /api/ai/explain falls back to computed scores locally.
PYTHON_EXPLAINER_URL="https://vyaparsethu-ai.onrender.com"

# ─── Bell24h-OS integration (OS-INTEGRATION-IMPLEMENTATION-01) ──────────────
# Server-only. Powers src/lib/bell24h-os/client.ts and the admin test route
# at /api/admin/bell24h-os/test-ai. NOT CONFIGURED as of this sprint — the
# route reports NOT_AVAILABLE until both vars below are set. Scope: AI text
# generation only (POST /api/v1/ai/text on the Bell24h-OS side) — no other
# Bell24h-OS capability is called from this repository.
#
# BELL24H_VYAPARSETHU_SERVICE_TOKEN must be the EXACT SAME value configured
# as BELL24H_VYAPARSETHU_SERVICE_TOKEN on the Bell24h-OS deployment
# (server/middleware/requireServiceAuth.ts in that repository) — it is one
# shared secret, not a VyaparSethu-generated one.
BELL24H_OS_BASE_URL=""               # e.g. https://digitex-erp-bell24h-os.vercel.app — no default, never falls back to localhost
BELL24H_VYAPARSETHU_SERVICE_TOKEN="" # shared secret — must match the Bell24h-OS side exactly

# Feature flags (src/lib/feature-flags.ts) — all default false until their phase gate opens
NEXT_PUBLIC_INTELLIGENCE_ENABLED=false
NEXT_PUBLIC_SHAP_ENABLED=false
NEXT_PUBLIC_VOICE_RFQ_ENABLED=false
NEXT_PUBLIC_VIDEO_RFQ_ENABLED=false
NEXT_PUBLIC_AI_AGENTS_ENABLED=false
NEXT_PUBLIC_AI_FACTORY_ENABLED=false
