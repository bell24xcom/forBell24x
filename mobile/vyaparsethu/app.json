{
  "expo": {
    "name": "VyaparSethu",
    "slug": "vyaparsethu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vyaparsethu",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitexstudio.vyaparsethu"
    },
    "android": {
      "package": "com.digitexstudio.vyaparsethu",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1F45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VyaparSethu to access your microphone to record Voice Requirements."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B1F45"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F45",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ]
  }
}
