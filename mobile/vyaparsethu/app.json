{
  "expo": {
    "name": "VyaparSethu",
    "slug": "vyaparsethu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vyaparsethu",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitexstudio.vyaparsethu"
    },
    "android": {
      "package": "com.digitexstudio.vyaparsethu",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1F45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VyaparSethu to access your microphone to record Voice Requirements."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VyaparSethu to access your camera to record Video Requirements.",
          "microphonePermission": "Allow VyaparSethu to access your microphone to record Video Requirements.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B1F45"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F45",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5750a4df-1219-48ad-ba93-abe8a3a75a43"
      }
    }
  }
}
