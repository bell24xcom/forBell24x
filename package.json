{
  "name": "bell24h",
  "version": "1.0.0",
  "description": "Bell24h B2B RFQ Marketplace",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push --accept-data-loss",
