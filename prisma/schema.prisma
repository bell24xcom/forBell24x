generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String         @id @default(cuid())
  email                String?        @unique
  name                 String?
  role                 UserRole       @default(SUPPLIER)
  isActive             Boolean        @default(true)
  isVerified           Boolean        @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  phone                String?        @unique
  company              String?
  gstNumber            String?
  udyamNumber          String?
  trustScore           Int            @default(0)
  location             String?
  avatar               String?
  preferences          Json?
  plan                 UserPlan       @default(FREE)
  claimedAt            DateTime?      @map("claimed_at")
  importedFrom         String?        @map("imported_from")
  isClaimed            Boolean        @default(false) @map("is_claimed")
  claimToken           String?        @unique @map("claim_token")
  claimSentAt          DateTime?      @map("claim_sent_at")
  outreachCount        Int            @default(0) @map("outreach_count")
  lastOutreachAt       DateTime?      @map("last_outreach_at")
  isPremium            Boolean        @default(false) @map("is_premium")
  /// Distinct from isVerified (phone-OTP). Tracks business verification level.
  verificationStatus   VerificationStatus @default(PHONE_VERIFIED) @map("verification_status")
  premiumPlan          String?        @map("premium_plan")
  premiumExpiry        DateTime?      @map("premium_expiry")
  planActivatedAt      DateTime?      @map("plan_activated_at")
  planExpiresAt        DateTime?      @map("plan_expires_at")
  buyerDeals           Deal[]         @relation("BuyerDeals")
  supplierDeals        Deal[]         @relation("SupplierDeals")
  leads                Lead[]
  sentMessages         Message[]      @relation("SentMessages")
  receivedMessages     Message[]      @relation("ReceivedMessages")
  notifications        Notification[]
  quotes               Quote[]
  conciergeQuotesSourced Quote[]      @relation("ConciergeSourcedQuotes")
  kycDocuments         KycDocument[]  @relation("KycDocumentsOwned")
  kycDocumentsReviewed KycDocument[]  @relation("KycDocumentsReviewed")
  reviewsGiven         Review[]       @relation("ReviewsGiven")
  reviewsReceived      Review[]       @relation("ReviewsReceived")
  rfqs                 RFQ[]
  buyerTransactions    Transaction[]  @relation("BuyerTransactions")
  supplierTransactions Transaction[]  @relation("SupplierTransactions")
  wallet               Wallet?
  companyDnaProfile    CompanyDnaProfile?
  lifeEvents           BusinessLifeEvent[] @relation("CompanyLifeEvents")
  lifeEventsAsActor    BusinessLifeEvent[] @relation("ActorLifeEvents")

  @@map("users")
}

model OTPVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  otp        String
  expiresAt  DateTime
  attempts   Int      @default(0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("otp_verifications")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug        String     @unique
  description String?
  priority    Int        @default(0)
  parentId    Int?       @map("parent_id")
  icon        String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  rfqs        RFQ[]

  @@map("categories")
}

model Webhook {
  id        String   @id @default(cuid())
  eventType String   @map("event_type")
  payload   Json
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("webhooks")
}

model RFQ {
  id             String        @id @default(cuid())
  title          String
  description    String?
  category       String
  quantity       String
  unit           String        @default("units")
  status         RFQStatus     @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categoryId     Int?          @map("category_id")
  acceptedAt     DateTime?
  completedAt    DateTime?
  createdBy      String?       @map("created_by")
  estimatedValue Float?
  expiresAt      DateTime?
  isPublic       Boolean       @default(true)
  location       String?
  maxBudget      Float?
  minBudget      Float?
  priority       Int           @default(3)
  requirements   String?
  tags           String[]
  timeline       String?
  type           String?
  videoUrl       String?
  videoPublicId  String?
  views          Int           @default(0)
  urgency        RFQUrgency    @default(NORMAL)
  isSeeded       Boolean       @default(false) @map("is_seeded")
  slug           String?       @unique
  deals          Deal[]
  quotes         Quote[]
  categoryRel    Category?     @relation(fields: [categoryId], references: [id])
  user           User?         @relation(fields: [createdBy], references: [id])
  transactions   Transaction[]

  @@map("rfqs")
}

model Quote {
  id             String        @id @default(cuid())
  price          Float
  quantity       String
  description    String?
  status         QuoteStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isAccepted     Boolean       @default(false)
  rfqId          String?       @map("rfq_id")
  supplierId     String?       @map("supplier_id")
  terms          String?
  timeline       String?
  deliveryDays   Int?          @map("delivery_days")
  notes          String?
  // Concierge sourcing: staff enters a real quote, obtained off-platform from
  // a real supplier, on that supplier's behalf. Never used for fabricated
  // suppliers or invented prices — sourcingNote is the audit trail (who was
  // contacted, when, how) and is required whenever source is CONCIERGE_SOURCED.
  source         QuoteSource   @default(SELF_SUBMITTED)
  sourcedByUserId String?      @map("sourced_by_user_id")
  sourcingNote   String?       @map("sourcing_note")
  deal           Deal?
  rfq            RFQ?          @relation(fields: [rfqId], references: [id])
  supplier       User?         @relation(fields: [supplierId], references: [id])
  sourcedBy      User?         @relation("ConciergeSourcedQuotes", fields: [sourcedByUserId], references: [id])
  transactions   Transaction[]

  @@map("quotes")
}

enum QuoteSource {
  SELF_SUBMITTED
  CONCIERGE_SOURCED
}

model KycDocument {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  documentType   KycDocumentType   @map("document_type")
  fileUrl        String            @map("file_url")
  cloudinaryId   String            @map("cloudinary_id")
  status         KycDocumentStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason")
  reviewedByUserId String?         @map("reviewed_by_user_id")
  reviewedAt     DateTime?         @map("reviewed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation("KycDocumentsOwned", fields: [userId], references: [id])
  reviewedBy     User?             @relation("KycDocumentsReviewed", fields: [reviewedByUserId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("kyc_documents")
}

enum KycDocumentType {
  ID_PROOF
  GST_CERTIFICATE
  BUSINESS_REGISTRATION
}

enum KycDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Deal {
  id         String   @id @default(cuid())
  rfqId      String   @map("rfq_id")
  quoteId    String   @unique @map("quote_id")
  buyerId    String   @map("buyer_id")
  supplierId String   @map("supplier_id")
  price      Float
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  buyer      User     @relation("BuyerDeals", fields: [buyerId], references: [id])
  quote      Quote    @relation(fields: [quoteId], references: [id])
  rfq        RFQ      @relation(fields: [rfqId], references: [id])
  supplier   User     @relation("SupplierDeals", fields: [supplierId], references: [id])
  reviews    Review[]

  @@map("deals")
}

model Review {
  id         String   @id @default(cuid())
  dealId     String   @map("deal_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  deal       Deal     @relation(fields: [dealId], references: [id])
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([dealId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Transaction {
  id            String            @id @default(cuid())
  rfqId         String            @map("rfq_id")
  quoteId       String?           @map("quote_id")
  buyerId       String            @map("buyer_id")
  supplierId    String            @map("supplier_id")
  amount        Float
  currency      String            @default("INR")
  status        TransactionStatus @default(PENDING)
  paymentMethod String?
  paymentId     String?           @map("payment_id")
  escrowId      String?           @map("escrow_id")
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  buyer         User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  quote         Quote?            @relation(fields: [quoteId], references: [id])
  rfq           RFQ               @relation(fields: [rfqId], references: [id])
  supplier      User              @relation("SupplierTransactions", fields: [supplierId], references: [id])

  @@map("transactions")
}

model Lead {
  id         String     @id @default(cuid())
  assignedTo String?    @map("assigned_to")
  company    String?
  createdAt  DateTime   @default(now())
  createdBy  String?    @map("created_by")
  email      String?
  message    String?
  name       String
  phone      String?
  source     String?
  updatedAt  DateTime   @updatedAt
  status     LeadStatus @default(NEW)
  user       User?      @relation(fields: [createdBy], references: [id])

  @@map("leads")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  data      Json?
  userId    String?          @map("user_id")
  user      User?            @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique @map("user_id")
  balance      Float               @default(0)
  currency     String              @default("INR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String   @map("wallet_id")
  type        String
  amount      Float
  description String?
  reference   String?
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@map("wallet_transactions")
}

model Message {
  id        String   @id @default(cuid())
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  rfqId     String?  @map("rfq_id")
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  from      User     @relation("SentMessages", fields: [fromId], references: [id])
  to        User     @relation("ReceivedMessages", fields: [toId], references: [id])

  @@map("messages")
}

model ErrorLog {
  id        String   @id @default(cuid())
  route     String
  method    String   @default("POST")
  message   String
  stack     String?
  userId    String?  @map("user_id")
  severity  String   @default("error")
  meta      Json?
  createdAt DateTime @default(now())

  @@map("error_logs")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("feature_flags")
}

model UserCredits {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  credits   Int      @default(0)
  spent     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_credits")
}

model CreditPurchase {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  credits    Int
  amount     Float
  razorpayId String?  @map("razorpay_id")
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("credit_purchases")
}

model LeadSupplier {
  id         String    @id @default(cuid())
  leadId     String    @map("lead_id")
  supplierId String    @map("supplier_id")
  unlocked   Boolean   @default(false)
  unlockedAt DateTime?
  credits    Int       @default(0)
  createdAt  DateTime  @default(now())

  @@map("lead_suppliers")
}

model RfqMemory {
  id         String   @id @default(cuid())
  rfqId      String   @unique @map("rfq_id")
  title      String
  category   String
  product    String?
  intent     String?
  priceRange String?  @map("price_range")
  quantity   String?
  location   String?
  metadata   Json?
  embedding  String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("rfq_memory")
}

model InteractionMemory {
  id         String   @id @default(cuid())
  rfqId      String?  @map("rfq_id")
  userId     String?  @map("user_id")
  sessionId  String?  @map("session_id")
  actionType String   @map("action_type")
  source     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("interaction_memory")
}

model QuoteMemory {
  id         String            @id @default(cuid())
  rfqId      String            @map("rfq_id")
  supplierId String            @map("supplier_id")
  price      Float
  quantity   String
  status     QuoteMemoryStatus @default(PENDING)
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  @@map("quote_memory")
}

model MarketInsight {
  id             String      @id @default(cuid())
  category       String      @unique
  avgPrice       Float?      @map("avg_price")
  minPrice       Float?      @map("min_price")
  maxPrice       Float?      @map("max_price")
  successRate    Float?      @default(0) @map("success_rate")
  avgTimeline    String?     @map("avg_timeline")
  demandTrend    DemandTrend @default(STABLE)
  rfqCount       Int         @default(0) @map("rfq_count")
  quoteCount     Int         @default(0) @map("quote_count")
  conversionRate Float?      @default(0) @map("conversion_rate")
  lastUpdated    DateTime    @default(now()) @map("last_updated")
  metadata       Json?

  @@map("market_insights")
}

// ─── Company DNA (Business Operating Memory) ─────────────────────────────────

model CompanyDnaProfile {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  companyName       String?            @map("company_name")
  completeness      Float              @default(0)
  layerScores       Json?              @map("layer_scores")
  identity          Json?
  business          Json?
  procurement       Json?
  suppliers         Json?
  customers         Json?
  financial         Json?
  market            Json?
  risk              Json?
  trust             Json?
  relationships     Json?
  procurementMemory Json?              @map("procurement_memory")
  decisions         Json?
  opportunities     Json?
  aiMemory          Json?              @map("ai_memory")
  graphSnapshot     Json?              @map("graph_snapshot")
  lastSyncedAt      DateTime           @default(now()) @map("last_synced_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeline          DnaTimelineEvent[]
  memoryEvents      DnaMemoryEvent[]

  @@map("company_dna_profiles")
}

model DnaTimelineEvent {
  id        String            @id @default(cuid())
  profileId String            @map("profile_id")
  year      Int
  label     String
  eventType String            @map("event_type")
  source    String            @default("system")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")
  profile   CompanyDnaProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("dna_timeline_events")
}

model DnaMemoryEvent {
  id          String            @id @default(cuid())
  profileId   String            @map("profile_id")
  layer       String
  eventType   String            @map("event_type")
  decision    String?
  outcome     String?
  impactScore Float?            @map("impact_score")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  profile     CompanyDnaProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([layer])
  @@map("dna_memory_events")
}

// ─── Business Operating Memory — universal event stream ────────────────────────
// Center of architecture: Business Life. Company DNA / graphs / briefs project from here.

model BusinessLifeEvent {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  eventType   String   @map("event_type")
  actorId     String?  @map("actor_id")
  category    String?
  intent      String?
  decision    String?
  outcome     String?
  metadata    Json?
  attachments Json?
  confidence  Float?
  source      String   @default("system")
  createdAt   DateTime @default(now()) @map("created_at")
  company     User     @relation("CompanyLifeEvents", fields: [companyId], references: [id], onDelete: Cascade)
  actor       User?    @relation("ActorLifeEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([eventType])
  @@index([companyId, eventType])
  @@map("business_life_events")
}

// ─── Product / Industry Intelligence — DB-backed catalog (replaces static TS catalogs) ────

model ProductIntelligenceRecord {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  family           String?
  category         String
  subcategory      String?
  brand            String?
  description      String
  manufacturing    Json?
  commercial       Json?
  knowledge        Json?
  businessIntel    Json?    @map("business_intel")
  seo              Json?
  referenceCompany String?  @map("reference_company")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category])
  @@index([family])
  @@map("product_intelligence_records")
}

model IndustryIntelligenceRecord {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  manufacturers       String[] @default([])
  suppliers           String[] @default([])
  buyers              String[] @default([])
  products            String[] @default([])
  machines            String[] @default([])
  rawMaterials        String[] @default([]) @map("raw_materials")
  standards           String[] @default([])
  tradeAssociations   String[] @default([]) @map("trade_associations")
  tradeShows          String[] @default([]) @map("trade_shows")
  governmentSchemes   String[] @default([]) @map("government_schemes")
  certifications      String[] @default([])
  relatedClusterSlugs String[] @default([]) @map("related_cluster_slugs")
  relatedProductSlugs String[] @default([]) @map("related_product_slugs")
  trends              Json
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("industry_intelligence_records")
}

model ExternalLead {
  id          String    @id @default(cuid())
  source      String
  rawText     String    @map("raw_text")
  name        String?
  company     String?
  phone       String?
  email       String?
  location    String?
  category    String?
  requirement String?
  budgetHint  String?   @map("budget_hint")
  status      String    @default("new")
  rfqId       String?   @map("rfq_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@map("external_leads")
}

model UserBehaviorMemory {
  id                  String   @id @default(cuid())
  category            String   @unique
  sessionCount        Int      @default(0) @map("session_count")
  avgDropStage        String?  @map("avg_drop_stage")
  dropRate            Float?   @default(0) @map("drop_rate")
  avgTimeToQuoteHours Float?   @map("avg_time_to_quote_hours")
  conversionRate      Float?   @default(0) @map("conversion_rate")
  topFailures         Json?    @map("top_failures")
  lastAnalyzed        DateTime @default(now()) @map("last_analyzed")

  @@map("user_behavior_memory")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  rfqId     String?  @map("rfq_id")
  role      String?
  type      String
  rating    Int?
  message   String
  page      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model CampaignRule {
  id           String   @id @default(cuid())
  isActive     Boolean  @default(true) @map("is_active")
  category     String
  urgency      String
  templateText String   @map("template_text")
  actionType   String   @map("action_type")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("campaign_rules")
}

enum UserRole {
  SUPPLIER
  BUYER
  ADMIN
  AGENT
}

/// Supplier verification level — distinct from the phone-OTP isVerified flag.
/// PHONE_VERIFIED: OTP registered only (default for all new users).
/// GST_PENDING:    Supplier submitted GST/Udyam, awaiting admin review.
/// GST_VERIFIED:   Admin confirmed GST/Udyam number is valid.
/// MANUAL_VERIFIED: Founder manually verified (e.g. in-person, no GST yet).
/// REJECTED:       Verification failed or fraudulent documents detected.
enum VerificationStatus {
  PHONE_VERIFIED
  GST_PENDING
  GST_VERIFIED
  MANUAL_VERIFIED
  REJECTED
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum RFQStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
  DRAFT
  ACTIVE
  QUOTED
  ACCEPTED
  IN_PROGRESS
  EXPIRED
  CLOSED_EXTERNAL
}

enum RFQUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum QuoteMemoryStatus {
  PENDING
  WON
  LOST
  EXPIRED
}

enum DemandTrend {
  RISING
  STABLE
  DECLINING
}

// ─── DPDP Compliance models ───────────────────────────────────────────────────
// Retain all logs ≥ 1 year (do NOT add auto-purge to these tables)

model ConsentEvent {
  id                 String   @id @default(cuid())
  userId             String?  @map("user_id")
  contactId          String?  @map("contact_id")
  purpose            String
  method             String
  language           String   @default("en")
  ipHash             String?  @map("ip_hash")
  consentTextVersion String   @map("consent_text_version")
  granted            Boolean
  createdAt          DateTime @default(now()) @map("created_at")
  // ISO country code of the regime governing this event, and the lawful
  // basis relied on. Optional and unpopulated for now — no ConsentEvent rows
  // exist yet (writes are still gated by NO_CONSENT_UI) — but additive here
  // is free while the table is empty, and a backfill later would not be.
  jurisdiction       String?      @map("jurisdiction")
  lawfulBasis        LawfulBasis? @map("lawful_basis")

  @@map("consent_events")
}

model ErasureRequest {
  id                  String        @id @default(cuid())
  requesterIdentifier String        @map("requester_identifier")
  status              ErasureStatus @default(RECEIVED)
  requestedAt         DateTime      @default(now()) @map("requested_at")
  completedAt         DateTime?     @map("completed_at")
  handledBy           String?       @map("handled_by")
  notes               String?
  userId              String?       @map("user_id")

  @@map("erasure_requests")
}

model OutreachConsentLog {
  id          String    @id @default(cuid())
  contactId   String    @map("contact_id")
  channel     String
  optInSource String    @map("opt_in_source")
  optOutAt    DateTime? @map("opt_out_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("outreach_consent_log")
}

model DataAccessLog {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  action      String
  entity      String
  entityId    String   @map("entity_id")
  timestamp   DateTime @default(now())

  @@map("data_access_log")
}

enum ErasureStatus {
  RECEIVED
  VERIFYING
  COMPLETED
  REJECTED
}

enum LawfulBasis {
  CONSENT
  LEGITIMATE_INTEREST
  CONTRACT
  LEGAL_OBLIGATION
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  RFQ_NEW
  QUOTE_RECEIVED
  ORDER_UPDATE
  PAYMENT_UPDATE
  RFQ_CREATED
  QUOTE_ACCEPTED
  DEAL_CHECK
  DEAL_CONFIRMED
  TRANSACTION_UPDATE
  SYSTEM_ALERT
}
